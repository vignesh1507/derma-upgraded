# =============================================================================
# Enervera Medical GraphRAG — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your real credentials.
# Variables marked REQUIRED must be set or the application will refuse to start.
# Variables marked OPTIONAL fall back to the listed default.
# =============================================================================

# -----------------------------------------------------------------------------
# HTTP service (FastAPI on Render)
# -----------------------------------------------------------------------------
# OPTIONAL — port the uvicorn server binds to. Render injects this automatically.
PORT=8000

# OPTIONAL — log verbosity: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# OPTIONAL — when set, /chat and /episodic routes require X-API-Key matching.
# Leave blank for an open API (internal use only).
API_KEY=

# OPTIONAL — comma-separated CORS origins for the frontend. "*" allows any.
# Tighten this to your real frontend URL(s) in production:
#   CORS_ORIGINS=https://app.enervera.com,https://staging.enervera.com
# Health, /metrics and /docs are always public regardless of this setting.
CORS_ORIGINS=*

# OPTIONAL — when true, /chat includes the internal gatekeeper `analysis`
# block (intent, risk_level, medical_entities, rewritten_query, final_action)
# in the JSON response. Default false: production never exposes the query
# analyser's internals. Enable only for local debugging.
EXPOSE_DIAGNOSTICS=false

# -----------------------------------------------------------------------------
# Pinecone (vector index)
# -----------------------------------------------------------------------------
# REQUIRED — Pinecone API key (https://app.pinecone.io/)
PINECONE_API_KEY=

# OPTIONAL — Pinecone index holding the DERMATOLOGY knowledge corpus.
# This is what makes answers specialty-correct; the persona alone is not enough.
# Contract: llama-text-embed-v2, dim 1024, cosine, chunk metadata with at least
# {summary, entities}. Default: enervara-specialists
PINECONE_INDEX_NAME=enervara-specialists

# REQUIRED for enervara-specialists — that index is partitioned per specialty
# and holds NOTHING in the default namespace, so an unset namespace retrieves
# zero chunks and the service answers ungrounded with no error.
# Namespaces present: dermatology, cardiology, ent, ophthalmology,
# orthopaedics, pulmonology_v1. Leave empty for single-namespace indexes.
PINECONE_NAMESPACE=dermatology

# -----------------------------------------------------------------------------
# Neo4j (knowledge graph) — currently hosted on Neo4j Aura
# -----------------------------------------------------------------------------
# REQUIRED — Neo4j connection URI.
#   Aura  →  neo4j+s://<dbid>.databases.neo4j.io   (TLS + routing, recommended)
#   Aura  →  neo4j+ssc://<dbid>.databases.neo4j.io (TLS, self-signed-cert variant)
#   Local →  bolt://127.0.0.1:7687
# Grab the Aura URI from the "Connection URI" field on your instance page.
NEO4J_URI=neo4j+s://<your-aura-dbid>.databases.neo4j.io

# OPTIONAL — Neo4j username. Aura defaults to `neo4j` on the free tier.
NEO4J_USERNAME=neo4j

# REQUIRED — Neo4j password. Aura shows it once at instance creation; if you
# lost it, reset from the Aura console (this rotates the credential).
NEO4J_PASSWORD=

# -----------------------------------------------------------------------------
# Google Gemini (LLM — answer, classifier, analyzer, extraction, cleaning)
# -----------------------------------------------------------------------------
# REQUIRED — Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OPTIONAL — every model role defaults to gemini-2.5-flash-lite. If Lite's
# free-tier quota becomes a problem, override individual roles (or all of
# them) to gemini-2.5-flash here.
# ANSWER_MODEL=gemini-2.5-flash-lite
# EXTRACTION_MODEL=gemini-2.5-flash-lite
# CLEANING_MODEL=gemini-2.5-flash-lite
# CLASSIFIER_MODEL=gemini-2.5-flash-lite
# QUERY_ANALYZER_MODEL=gemini-2.5-flash-lite
# SUMMARIZATION_MODEL=gemini-2.5-flash-lite

# -----------------------------------------------------------------------------
# Episodic memory (Pinecone-backed, isolated from longitudinal Postgres)
# -----------------------------------------------------------------------------
# Pinecone index name used by the episodic memory layer.
PINECONE_EPISODIC_INDEX_NAME=episodicmemory

# -----------------------------------------------------------------------------
# Redis (session memory — optional; falls back to in-memory store)
# -----------------------------------------------------------------------------
# OPTIONAL — Redis connection URL. Default: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# OPTIONAL — Session time-to-live in seconds. Default: 7200 (2 hours)
SESSION_TTL_SEC=7200

# -----------------------------------------------------------------------------
# MongoDB (read-only authoritative patient demographics)
# -----------------------------------------------------------------------------
# OPTIONAL — connection string to the Mongo holding `enervara.users`. When set,
# the AI loads AI-safe demographics (age/sex/height/weight/BMI/location) for the
# request's user_id and injects them ONLY when relevant. Leave blank to disable;
# any Mongo error also degrades gracefully to "no demographics".
MONGO_URI=
# OPTIONAL — database + collection names. Defaults shown.
MONGO_DB=enervara
MONGO_USERS_COLLECTION=users
# OPTIONAL — master switch (default true). Set false to skip demographics.
DEMOGRAPHICS_ENABLED=true
# OPTIONAL — Mongo timeout in ms (default 3000) so a slow DB never stalls chat.
MONGO_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# PMS (Patient Memory Service) — shadow producer, OFF in production
# -----------------------------------------------------------------------------
# Master rollout flag. false (production default) = NullPMSClient: no HTTP, no
# latency, no behaviour change. true = HttpPMSClient in fire-and-forget SHADOW
# mode — chat never waits for PMS and PMS failures never affect users.
ENABLE_PMS_SHADOW=false
# Inbound identity parsing ALWAYS accepts both legacy (user_id/session_id) and
# the new `identity` envelope. This flag only controls whether the envelope is
# preferred; it never removes backward compatibility.
ENABLE_IDENTITY_V1=true
# PMS connection — only used when ENABLE_PMS_SHADOW=true. If BASE_URL is unset
# while the flag is true, GM safely falls back to NullPMSClient. The base URL is
# the internal AWS ALB (VPC-only); read from config, never hardcoded.
PMS_BASE_URL=
PMS_INGEST_PATH=/v1/clinical-memory/events
# Service JWT for Authorization: Bearer. Provisioned by the auth component /
# secret manager. Without it the client will NOT send (no anonymous requests).
PMS_SERVICE_JWT=
# Separate connect + read timeouts (ms).
PMS_CONNECT_TIMEOUT_MS=1000
PMS_READ_TIMEOUT_MS=1500
PMS_MAX_RETRIES=1
PMS_CONSUMER_ID=general-medicine

# -----------------------------------------------------------------------------
# PostgreSQL (longitudinal memory — canonical store)
# -----------------------------------------------------------------------------
# REQUIRED for the new memory/ subsystem.
# Format: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enervera

# OPTIONAL — Patient-state hot cache TTL in seconds. Default: 300 (5 minutes).
MEMORY_CACHE_TTL_SEC=300
